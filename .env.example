# Copia este fichero a .env y ajusta lo que haga falta.
#   cp .env.example .env
#
# Ninguna de estas variables es obligatoria para arrancar en local: application.yaml trae valores
# por defecto que funcionan contra mto-configuration y mto-stock corriendo en el host.

# --- El propio gateway -------------------------------------------------------------------------
SERVER_PORT=8090
# Puerto publicado en el host por compose. Solo lo usa compose.yaml.
APP_PORT=8090
# local | docker. Sin perfil, valen los valores de application.yaml.
SPRING_PROFILES_ACTIVE=local

# --- Servicios de destino ----------------------------------------------------------------------
# OJO: mto-stock escucha en el 8080 y mto-configuration en el 8081. El 8082 es Keycloak.
MTO_CONFIGURATION_URL=http://localhost:8081
MTO_STOCK_URL=http://localhost:8080

# --- Timeouts ----------------------------------------------------------------------------------
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_READ_TIMEOUT=15s
# Red de seguridad del circuit breaker. Mayor que el read-timeout a proposito.
GATEWAY_CIRCUIT_BREAKER_TIMEOUT=20s

# --- Seguridad ---------------------------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
# Cliente del gateway en el realm. De el se leen los roles ops-metrics / ops-write.
KEYCLOAK_CLIENT_ID=mto-gateway-api
# Desactivada por defecto: la audiencia es por servicio y cada uno valida la suya. Ver README.md.
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=false
KEYCLOAK_AUDIENCE=

# --- CORS --------------------------------------------------------------------------------------
# Lista separada por comas. Sin comodines.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# --- Observabilidad ----------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus

# Trazado distribuido. El gateway es el borde: aqui nace la traza, que continua en mto-configuration
# y en mto-stock -incluido el salto por la cola de RabbitMQ entre los dos-, de modo que se ve entera
# en un unico Jaeger, el de mto-platform.
MTO_TRACING_ENABLED=true
# 0.1 = se muestrea el 10%. Un span no muestreado sigue propagando su traceparent (flag 00), asi que
# muestrear poco no rompe la cadena entre servicios.
MTO_TRACING_SAMPLING_PROBABILITY=0.1
# Colector OTLP por HTTP, el de mto-platform. Con nada escuchando ahi, el exportador solo deja un
# aviso en el log. Dentro de compose se alcanza por otel.mto.local; desde el IDE, por localhost.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
